rules_version = '2';

// Firebase Console > Firestore Database > Rules sekmesine yapıştırılıp "Publish" edilmeli
// (veya Firebase CLI ile: firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {

    // Sadece bu e-posta(lar) ile giriş yapan kullanıcı yazabilir.
    // "request.auth != null" yeterli DEĞİL: public API key ile herkes hesap açıp yazabilir.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['canyusufakyol@gmail.com'];
    }

    function isValidProject(data) {
      return data.keys().hasOnly(['baslik', 'baslik_tr', 'baslik_en', 'aciklama', 'aciklama_tr', 'aciklama_en',
                                  'durum', 'resimUrls', 'resimUrl', 'createdAt'])
        && data.durum in ['tamamlandi', 'devam_ediyor']
        // Eski yapıdaki projelerde bu alanlar olmayabilir; varsa kontrol ediliyor
        && (!('resimUrls' in data) || (data.resimUrls is list && data.resimUrls.size() <= 30))
        && (!('baslik_tr' in data) || (data.baslik_tr is string && data.baslik_tr.size() <= 300))
        && (!('aciklama_tr' in data) || (data.aciklama_tr is string && data.aciklama_tr.size() <= 10000));
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }

    // Diğer tüm koleksiyonlar kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
